# MikrOS x86-i586 M0 kernel policy fragment.
# A generated full .config will be committed only after qualification.
CONFIG_M586=y
CONFIG_X86_32=y
# GCC plugins are host-build hardening helpers, not required by the target.
# Avoid making the cross compiler's plugin headers impose host MPC headers.
# CONFIG_GCC_PLUGINS is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_EXT2_FS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_EARLY_PRINTK=y
# Keep early serial diagnostics available during x86 M0 qualification.
# CONFIG_EARLY_PRINTK_DBGP is not set
CONFIG_DEBUG_KERNEL=y
